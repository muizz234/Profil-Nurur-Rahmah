# Environment variables required on Vercel.
# Configure these in Project Settings -> Environment Variables.
# Never commit real secrets to this file.

APP_NAME="Pondok Pesantren Nurur Rahmah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stderr
LOG_LEVEL=error

VIEW_COMPILED_PATH=/tmp/views

SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120

CACHE_STORE=array

QUEUE_CONNECTION=sync

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Optional path to a CA certificate file available on the function runtime.
DB_SSL_CA=

FILESYSTEM_DISK=public
# Use "s3" to store public uploads on S3, or "local" to keep them on disk.
PUBLIC_DISK_DRIVER=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
